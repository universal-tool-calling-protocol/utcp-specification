{
  "utcp_version": "1.0.0",
  "manual_version": "1.0.0",
  "tools": [
    {
      "name": "search",
      "description": "Search pages and data sources (databases) the integration can access, by title. Start here to find IDs. Only finds content explicitly shared with the integration. Paginated: if the response has `has_more: true`, call again with `start_cursor` set to the returned `next_cursor`.",
      "tags": [
        "notion",
        "search"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "description": "Search request. All fields optional; an empty body lists everything shared with the integration.",
            "properties": {
              "query": {
                "type": "string",
                "description": "Text matched against page and data source titles."
              },
              "filter": {
                "type": "object",
                "description": "Restrict to one object type: {\"property\": \"object\", \"value\": \"page\"} or \"data_source\".",
                "properties": {
                  "property": {
                    "type": "string",
                    "enum": [
                      "object"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "enum": [
                      "page",
                      "data_source"
                    ]
                  }
                }
              },
              "sort": {
                "type": "object",
                "description": "{\"timestamp\": \"last_edited_time\", \"direction\": \"ascending\"|\"descending\"}. Default: most recently edited first.",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "enum": [
                      "last_edited_time"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "ascending",
                      "descending"
                    ]
                  }
                }
              },
              "start_cursor": {
                "type": "string",
                "description": "`next_cursor` from a previous response, to fetch the next page of results."
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Results per page (max 100, default 100)."
              }
            }
          }
        },
        "required": []
      },
      "outputs": {
        "type": "object",
        "description": "List response.",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "POST",
        "url": "https://api.notion.com/v1/search",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": "body",
        "header_fields": null
      },
      "average_response_size": 20000
    },
    {
      "name": "get_page",
      "description": "Retrieve a page's metadata and property values (title, status, dates, URL, parent). Does NOT return the page body; use get_page_markdown for content.",
      "tags": [
        "notion",
        "pages"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "Notion ID (UUID, with or without dashes). The 32-character hex string at the end of a Notion URL works."
          }
        },
        "required": [
          "page_id"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "Notion page object (id, url, parent, properties, in_trash, ...)."
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "GET",
        "url": "https://api.notion.com/v1/pages/{page_id}",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": null,
        "header_fields": null
      },
      "average_response_size": 3000
    },
    {
      "name": "get_page_markdown",
      "description": "Read a page's full content as enhanced Markdown. Preferred over get_block_children for reading: one call, compact output. Check the response: if `truncated` is true or `unknown_block_ids` is non-empty, part of the page is missing; read those blocks with get_block_children.",
      "tags": [
        "notion",
        "pages",
        "markdown"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "Notion ID (UUID, with or without dashes). The 32-character hex string at the end of a Notion URL works."
          },
          "include_transcript": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "description": "\"true\" to include meeting-note transcripts (default \"false\": a link placeholder is shown)."
          }
        },
        "required": [
          "page_id"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "Page content as Markdown.",
        "properties": {
          "markdown": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean",
            "description": "true if the content was cut off."
          },
          "unknown_block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Blocks that could not be rendered; fetch them with get_block_children."
          }
        }
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "GET",
        "url": "https://api.notion.com/v1/pages/{page_id}/markdown",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": null,
        "header_fields": null
      },
      "average_response_size": 8000
    },
    {
      "name": "create_page",
      "description": "Create a page under a page, or a new row in a database (data source parent). Give the body as Markdown in `markdown` (recommended, with markdown_version \"v2\") or as block objects in `children`, not both.",
      "tags": [
        "notion",
        "pages",
        "write"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "description": "Create-page request.",
            "properties": {
              "parent": {
                "type": "object",
                "description": "Where to create the page. One of: {\"type\": \"page_id\", \"page_id\": \"...\"} or {\"type\": \"data_source_id\", \"data_source_id\": \"...\"} (a row in a database; get the data source ID from get_database). {\"type\": \"database_id\", \"database_id\": \"...\"} is still accepted for databases with a single data source, but data_source_id is preferred. Internal integrations must give a parent.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "page_id",
                      "data_source_id",
                      "database_id"
                    ]
                  },
                  "page_id": {
                    "type": "string"
                  },
                  "data_source_id": {
                    "type": "string"
                  },
                  "database_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "oneOf": [
                  {
                    "properties": {
                      "type": {
                        "const": "page_id"
                      }
                    },
                    "required": [
                      "type",
                      "page_id"
                    ]
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "data_source_id"
                      }
                    },
                    "required": [
                      "type",
                      "data_source_id"
                    ]
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "database_id"
                      }
                    },
                    "required": [
                      "type",
                      "database_id"
                    ]
                  }
                ]
              },
              "properties": {
                "type": "object",
                "description": "Map of property name (or ID) to property value. Under a page parent only `title` is allowed, e.g. {\"title\": {\"title\": [{\"text\": {\"content\": \"My page\"}}]}}. Under a data source parent, keys must match the data source schema (see get_data_source). Formula, rollup and created/edited fields are read-only."
              },
              "markdown": {
                "type": "string",
                "description": "Page content as Markdown. Mutually exclusive with `children`."
              },
              "markdown_version": {
                "type": "string",
                "enum": [
                  "v2"
                ],
                "description": "Use \"v2\" whenever `markdown` is set."
              },
              "children": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object"
                },
                "description": "Page content as block objects (max 100). Mutually exclusive with `markdown`."
              },
              "icon": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Page icon, e.g. {\"type\": \"emoji\", \"emoji\": \"📝\"}. null removes it."
              },
              "cover": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Cover image, e.g. {\"type\": \"external\", \"external\": {\"url\": \"https://...\"}}. null removes it."
              },
              "template": {
                "type": "object",
                "description": "Data source template: {\"type\": \"default\"} or {\"type\": \"template_id\", \"template_id\": \"...\"}. Cannot be combined with children."
              }
            },
            "required": [
              "parent"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "markdown",
                    "children"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "template",
                    "children"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "body"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "Notion page object (id, url, parent, properties, in_trash, ...)."
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": "body",
        "header_fields": null
      },
      "average_response_size": 3000
    },
    {
      "name": "update_page",
      "description": "Update a page's properties, icon or cover, or move it to / restore it from the trash (`in_trash`). To change the page body use update_page_markdown or the block tools.",
      "tags": [
        "notion",
        "pages",
        "write"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "Notion ID (UUID, with or without dashes). The 32-character hex string at the end of a Notion URL works."
          },
          "body": {
            "type": "object",
            "description": "Fields to change; give at least one. Omitted fields are left as they are.",
            "properties": {
              "properties": {
                "type": "object",
                "description": "Map of property name (or ID) to property value. Under a page parent only `title` is allowed, e.g. {\"title\": {\"title\": [{\"text\": {\"content\": \"My page\"}}]}}. Under a data source parent, keys must match the data source schema (see get_data_source). Formula, rollup and created/edited fields are read-only."
              },
              "icon": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Page icon, e.g. {\"type\": \"emoji\", \"emoji\": \"📝\"}. null removes it."
              },
              "cover": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Cover image, e.g. {\"type\": \"external\", \"external\": {\"url\": \"https://...\"}}. null removes it."
              },
              "in_trash": {
                "type": "boolean",
                "description": "true moves the page to the trash; false restores it."
              }
            },
            "minProperties": 1
          }
        },
        "required": [
          "page_id",
          "body"
        ]
      },
      "outputs": {
        "type": "object",
        "description": "Notion page object (id, url, parent, properties, in_trash, ...)."
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "PATCH",
        "url": "https://api.notion.com/v1/pages/{page_id}",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": "body",
        "header_fields": null
      },
      "average_response_size": 3000
    },
    {
      "name": "update_page_markdown",
      "description": "Edit a page's content using Markdown. Use type \"update_content\" for targeted find-and-replace edits (safest), or \"replace_content\" to overwrite the whole page.",
      "tags": [
        "notion",
        "pages",
        "markdown",
        "write"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "description": "Notion ID (UUID, with or without dashes). The 32-character hex string at the end of a Notion URL works."
          },
          "body": {
            "type": "object",
            "description": "Exactly one edit operation: set `type` and the object of the same name. Example: {\"type\": \"update_content\", \"update_content\": {\"content_updates\": [{\"old_str\": \"Draft\", \"new_str\": \"Final\"}]}}.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "update_content",
                  "replace_content"
                ]
              },
              "update_content": {
                "type": "object",
                "properties": {
                  "content_updates": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "properties": {
                        "old_str": {
                          "type": "string",
                          "description": "Exact existing Markdown to find."
                        },
                        "new_str": {
                          "type": "string",
                          "description": "Replacement Markdown."
                        },
                        "replace_all_matches": {
                          "type": "boolean",
                          "description": "Replace every match, not just the first."
                        }
                      },
                      "required": [
                        "old_str",
                        "new_str"
                      ]
                    }
                  },
                  "allow_deleting_content": {
                    "type": "boolean",
                    "description": "Allow edits that remove child pages/databases."
                  }
                },
                "required": [
                  "content_updates"
                ]
              },
              "replace_content": {
                "type": "object",
                "properties": {
                  "new_str": {
                    "type": "string",
                    "description": "The complete new page content as Markdown."
                  },
                  "allow_deleting_content": {
                    "type": "boolean",
                    "description": "Allow removing child pages/databases not in new_str."
                  }
                },
                "required": [
                  "new_str"
                ]
              }
            },
            "required": [
              "type"
            ],
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "const": "update_content"
                  }
                },
                "required": [
                  "type",
                  "update_content"
                ],
                "not": {
                  "required": [
                    "replace_content"
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "replace_content"
                  }
                },
                "required": [
                  "type",
                  "replace_content"
                ],
                "not": {
                  "required": [
                    "update_content"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "page_id",
          "body"
        ]
      },
      "outputs": {
        "type": "object"
      },
      "tool_call_template": {
        "name": "notion",
        "call_template_type": "http",
        "http_method": "PATCH",
        "url": "https://api.notion.com/v1/pages/{page_id}/markdown",
        "content_type": "application/json",
        "auth": {
          "auth_type": "api_key",
          "api_key": "Bearer ${NOTION_TOKEN}",
          "var_name": "Authorization",
          "location": "header"
        },
        "headers": {
          "Notion-Version": "2026-03-11"
        },
        "body_field": "body",
        "header_fields": null
      },
      "average_response_size": 8000
    },
