    {
      "name": "append_block_children",
      "description": "Add blocks (paragraphs, headings, to-dos, lists, code...) to a page or block. Appends at the end unless `position` is given.",
      "tags": [
        "notion",
        "blocks",
        "write"
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "description": "Notion ID (UUID, with or without dashes). The 32-character hex string at the end of a Notion URL works. A page ID also works."
          },
          "body": {
            "type": "object",
